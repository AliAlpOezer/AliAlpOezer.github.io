---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="That page does not exist.">
  <div class="wrap panel">
    <p class="label">404</p>
    <h1>That page does not exist.</h1>
    <p class="lede">
      It may have been renamed, or it may never have existed. Either way, the things worth
      reading are still here.
    </p>
    <p class="links">
      <a class="link" href="/">Home</a>
      <a class="link" href="/work">Work</a>
      <a class="link" href="/writing">Writing</a>
    </p>
  </div>
</Base>

<style>
  .panel { padding-block: var(--space-3xl); }
  .label { margin-bottom: var(--space-sm); }
  h1 {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-snug);
  }
  .lede {
    max-width: var(--measure);
    margin-top: var(--space-md);
    color: var(--ink-muted);
  }
  .links { display: flex; gap: var(--space-md); margin-top: var(--space-lg); font-size: var(--text-sm); }
</style>
