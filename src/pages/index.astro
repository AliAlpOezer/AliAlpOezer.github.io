---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import QuietField from '../components/QuietField.astro';
import RunPanel from '../components/RunPanel.astro';
import StackField from '../components/StackField.astro';
import CopyButton from '../components/CopyButton.astro';
import { SITE } from '../consts';
import { LESSONS, FIGURES } from '../data/home';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const featured = projects.filter((p) => p.data.featured);
const grid = featured.length >= 5 ? featured.slice(0, 5) : projects.slice(0, 5);

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const latest = posts[0];

/* The stack display aggregates every shipped project's stack, then the
   explored tier is added inside the component. Built here because only the
   page has the collection. */
const byTech = new Map<string, { title: string; id: string }[]>();
for (const p of projects) {
  for (const tech of p.data.stack) {
    if (!byTech.has(tech)) byTech.set(tech, []);
    byTech.get(tech)!.push({ title: p.data.title, id: p.id });
  }
}
const shipped = [...byTech.entries()]
  .map(([name, projects]) => ({ name, projects }))
  .sort((a, b) => a.name.localeCompare(b.name));

const STATUS: Record<string, string> = {
  live: 'Running',
  shipped: 'Shipped',
  building: 'In progress',
  archived: 'Archived',
};

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title={`${SITE.name}, AI engineer in ${SITE.locality}`} bareTitle>
  <QuietField />

  <section class="hero" data-field>
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="intro">Hi, I'm Alp.</h1>
        <p class="hero-statement intro">
          <span class="visually-hidden">I build agents that work while I sleep, retrieval I can actually measure, voice agents that answer in a second, and tools that AI assistants can use.</span>
          <span aria-hidden="true">
            <span class="hero-statement-prefix">I build</span>
            <span class="hero-phrases" data-hero-phrases>
              <span class="hero-phrase" data-active="true">agents that work while I sleep.</span>
              <span class="hero-phrase">retrieval I can actually measure.</span>
              <span class="hero-phrase">voice agents that answer in a second.</span>
              <span class="hero-phrase">tools that AI assistants can use.</span>
            </span>
          </span>
        </p>
        <p class="hero-description intro">Three years of enterprise software taught me what it takes for software to hold up in front of real users. Now I build AI systems, mostly to understand how they really work, and I write down what each one teaches me.</p>
        <div class="hero-actions intro">
          <a class="hero-button hero-button--primary" href="#work">See what I built</a>
          <a class="hero-button" href="/cv/ali-alp-oezer.pdf" download="Ali-Alp-Oezer-CV.pdf">Download CV</a>
        </div>
      </div>
      <a class="hero-visual intro" href="/work/streamline" aria-label="Read about Streamline, a water reuse planner built at a hackathon">
        <img src="/project-media/streamline/focus.png" alt="Streamline's design canvas focusing on a proposed water reuse path between a bottle washer and cooling tower." fetchpriority="high" />
        <span class="hero-visual-caption"><span><strong>Streamline</strong><span class="hero-visual-sub">Planning water reuse in a factory</span></span><span class="hero-visual-go">Read more <span aria-hidden="true">↗</span></span></span>
      </a>
    </div>
  </section>

  <div class="intro-note">
    <div class="wrap">
      <p>This summer I set myself a sixteen-week AI engineering program with one rule: every block had to end in something that runs. Most of the projects below came out of it. In October I start a master's at TUM.</p>
      <a class="arw" href="/about">More about me</a>
    </div>
  </div>

  <section class="band" id="work">
    <div class="wrap">
      <div class="band-head reveal">
        <h2>Things I built</h2>
        <a class="arw" href="/work">All projects</a>
      </div>
      <div class="grid reveal" id="work-grid">
        {grid.map((p) => (
          <article class="card" data-stack={p.data.stack.join('|')}>
            {p.data.media[0] && (
              <a class="card-media" href={`/work/${p.id}`} aria-label={`View ${p.data.title}`}>
                <img src={p.data.media[0].src} alt={p.data.media[0].alt} loading="lazy" />
              </a>
            )}
            <div class="card-top">
              <span class="card-name">{p.data.title}</span>
              <span class="status" data-s={p.data.status}>{STATUS[p.data.status]}</span>
            </div>
            <h3>
              <a href={`/work/${p.id}`}>{p.data.headline}</a>
            </h3>
            <p>{p.data.summary}</p>
            {p.data.recognition && <p class="recognition">{p.data.recognition}</p>}
            <p class="tags">
              {p.data.stack.map((t) => <span class="tag" data-tag={t}>{t}</span>)}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--tile" id="run">
    <div class="wrap">
      <div class="band-head">
        <div>
          <p class="eyebrow">A closer look</p>
          <h2>Six steps. The model does one of them.</h2>
          <p class="band-lede">Good flats in Munich are gone within hours, so I built an agent that checks for me every three hours and messages me when something fits. Only one of its six steps uses a language model. That split is what I would carry into any agent: plain code for the decisions that have to be right, the model for the part that is genuinely fuzzy.</p>
          <a class="arw band-link" href="/work/munich-apartment-agent">The full story</a>
        </div>
      </div>
      <RunPanel
        system="Munich apartment agent"
        cadence="runs every 3 hours"
        store="saves to SQLite"
      />
    </div>
  </section>

  <section class="band band--sunk" id="stack">
    <div class="wrap">
      <StackField shipped={shipped} />
    </div>
  </section>

  <section class="band" id="method">
    <div class="wrap">
      <div class="band-head reveal">
        <div>
          <p class="eyebrow">Lessons that carry over</p>
          <h2>What building these taught me.</h2>
        </div>
      </div>
      {/* Exactly four entries, so the grid is 2x2 rather than auto-fit. An
          auto-fit grid left empty cells at wide widths and the 1px hairline
          background showed through them as a grey block. */}
      <div class="method reveal">
        {LESSONS.map((m) => (
          <div class="mth">
            <h3>{m.title}</h3>
            <p>{m.body}</p>
            <a class="arw from" href={m.from.href}>Learned on {m.from.name}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  {latest && (
    <section class="band" id="writing">
      <div class="wrap">
        <div class="band-head reveal">
          <h2>Writing</h2>
          <a class="arw" href="/writing">All posts</a>
        </div>
        <a class="post reveal" href={`/writing/${latest.id}`}>
          <span class="when">
            {fmtDate(latest.data.pubDate)}
            {latest.data.tags.length > 0 && ` · ${latest.data.tags.join(', ')}`}
          </span>
          <h3>{latest.data.title}</h3>
          <p>{latest.data.description}</p>
          <span class="go arw">Read it</span>
        </a>
      </div>
    </section>
  )}

  <section class="band band--tile" data-field="sparse">
    <div class="wrap">
      <div class="figs reveal">
        {FIGURES.map((f) => (
          <div class="fig">
            <b>{f.value}</b>
            <p class="small">{f.note}</p>
          </div>
        ))}
      </div>
      <div class="hail reveal">
        <h2>If you are hiring someone who builds like this, I would like to hear from you.</h2>
        <div class="links">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <CopyButton value={SITE.email} />
          <a href={SITE.github} rel="noopener">GitHub</a>
          <a href={SITE.linkedin} rel="noopener">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const heroPhrases = [...document.querySelectorAll<HTMLElement>('.hero-phrase')];
  if (heroPhrases.length > 1) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeIndex = 0;
    let rotation: number | undefined;

    const showPhrase = (index: number) => {
      heroPhrases[activeIndex].removeAttribute('data-active');
      activeIndex = index;
      heroPhrases[activeIndex].setAttribute('data-active', 'true');
    };

    const startRotation = () => {
      window.clearInterval(rotation);
      if (reducedMotion.matches || document.hidden) return;
      rotation = window.setInterval(() => {
        showPhrase((activeIndex + 1) % heroPhrases.length);
      }, 5000);
    };

    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) showPhrase(0);
      startRotation();
    });
    document.addEventListener('visibilitychange', startRotation);
    startRotation();
  }

  /* Pointer spotlight on the work grid and the method cards. The one effect
     carried over from the atmospheric mockup, at lower intensity and
     achromatic enough to read as light rather than as glow. */
  for (const host of document.querySelectorAll<HTMLElement>('#work-grid, .method')) {
    host.addEventListener('pointermove', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('.card, .mth');
      if (!el) return;
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${e.clientX - r.left}px`);
      el.style.setProperty('--my', `${e.clientY - r.top}px`);
    }, { passive: true });
  }

</script>

<style>
  .hero { min-height: min(42rem, 78vh); display: grid; align-items: center; padding-block: var(--space-2xl); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .95fr); gap: var(--space-xl); align-items: center; }
  .hero-copy { position: relative; z-index: 1; }
  .hero h1 { font-size: clamp(3.1rem, 5.7vw, 5.8rem); line-height: var(--leading-tight); }
  .hero-statement { margin-top: var(--space-sm); color: var(--accent); font-size: var(--text-xl); font-weight: 600; letter-spacing: var(--tracking-tight); }
  .hero-statement-prefix { display: block; }
  .hero-phrases { display: grid; }
  .hero-phrase { grid-area: 1 / 1; visibility: hidden; opacity: 0; transform: translateY(0.25em); transition: opacity var(--t-slow) var(--ease-out), transform var(--t-slow) var(--ease-out), visibility 0s var(--t-slow); }
  .hero-phrase[data-active='true'] { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
  .hero-description { max-width: var(--measure); margin-top: var(--space-md); color: var(--ink-muted); font-size: var(--text-md); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-top: var(--space-lg); }
  .hero-button { display: inline-flex; justify-content: center; align-items: center; min-height: 2.75rem; padding: var(--space-2xs) var(--space-md); border: var(--hairline) solid var(--rule-strong); border-radius: 999px; color: var(--ink); background: var(--paper); font-size: var(--text-sm); font-weight: 600; text-decoration: none; white-space: nowrap; transition: transform var(--t-fast) var(--ease-out), background-color var(--t-base) var(--ease-out); }
  .hero-button:hover { transform: translateY(-2px); }
  .hero-button:active { transform: translateY(0); }
  .hero-button--primary { background: var(--ink); color: var(--paper); }
  .hero-visual { display: block; position: relative; z-index: 1; overflow: hidden; border: var(--hairline) solid var(--rule); border-radius: var(--radius-lg); background: var(--paper); color: var(--ink); text-decoration: none; box-shadow: var(--shadow-product); transition: transform var(--t-slow) var(--ease-out); }
  .hero-visual:hover { transform: translateY(-4px); }
  .hero-visual img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: left top; }
  .hero-visual-caption { display: flex; justify-content: space-between; align-items: center; gap: var(--space-sm); padding: var(--space-sm) var(--space-md); font-size: var(--text-sm); }
  .hero-visual-caption strong { display: block; font-size: var(--text-md); }
  .hero-visual-sub { display: block; color: var(--ink-muted); }
  .hero-visual-go { color: var(--accent); white-space: nowrap; }
  .intro-note { padding-block: var(--space-xl); border-block: var(--hairline) solid var(--rule); }
  .intro-note .wrap { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-xl); align-items: end; }
  .intro-note p { max-width: 55rem; font-size: var(--text-lg); line-height: var(--leading-body); letter-spacing: var(--tracking-head); }
  .intro-note a { white-space: nowrap; font-size: var(--text-sm); }
  @media (max-width: 48rem) {
    .hero { min-height: 0; }
    .hero-grid, .intro-note .wrap { grid-template-columns: 1fr; }
    .hero h1 { font-size: clamp(2.8rem, 12vw, 4.5rem); }
    .hero-visual { max-width: 36rem; }
    .hero-visual img { aspect-ratio: 16 / 10; }
    .intro-note .wrap { gap: var(--space-sm); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-button, .hero-visual, .hero-phrase { transition: none; }
  }

  /* ---------- run band intro ---------- */
  .band-lede { max-width: var(--measure-wide); margin-top: var(--space-sm); color: var(--on-tile-mute); font-size: var(--text-md); line-height: var(--leading-body); }
  .band-link { display: inline-block; margin-top: var(--space-sm); color: var(--accent-lift); font-size: var(--text-sm); }

  /* ---------- work grid + pointer spotlight ---------- */
  .grid {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    isolation: isolate;
  }
  .card {
    position: relative;
    background: var(--paper);
    padding: var(--space-lg) 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    min-height: 15rem;
    transition: opacity var(--t-slow) var(--ease-out);
  }
  .card-media { display: block; margin: calc(-1 * var(--space-lg)) -1.75rem var(--space-lg); overflow: hidden; aspect-ratio: 16 / 9; background: var(--paper-sunk); }
  .card-media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform var(--t-slow) var(--ease-out); }
  .card:hover .card-media img { transform: scale(1.025); }
  .card:first-child { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); grid-template-rows: auto auto auto auto 1fr; column-gap: var(--space-lg); min-height: 20rem; }
  .card:first-child .card-media { grid-column: 1; grid-row: 1 / -1; height: calc(100% + 2 * var(--space-lg)); margin: calc(-1 * var(--space-lg)) 0 calc(-1 * var(--space-lg)) -1.75rem; aspect-ratio: auto; }
  .card:first-child .card-top, .card:first-child h3, .card:first-child > p { grid-column: 2; }
  .card:first-child .tags { grid-row: 5; }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity var(--t-slow) var(--ease-out);
    background: radial-gradient(16rem 16rem at var(--mx) var(--my),
                rgb(0 102 204 / 0.07), transparent 68%);
  }
  .grid:hover .card::before { opacity: 1; }
  .card > * { position: relative; z-index: 1; }
  .card[data-dim='true'] { opacity: 0.26; }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }
  .card-name { font-size: var(--text-sm); font-weight: 600; color: var(--ink-faint); }
  .card h3 { margin-top: var(--space-2xs); font-size: var(--text-lg); line-height: var(--leading-snug); }
  /* No lift on hover: the grid is one hairline-separated surface and raising a
     cell tears the seam it shares with its neighbours. The affordance is
     carried by the title instead. The arrow is positioned out of flow -
     laying it out inline reserves width even at opacity 0, which was enough
     to wrap a long title onto a second line while its neighbours stayed on one. */
  .card h3 a {
    position: relative;
    text-decoration: none;
    transition: color var(--t-base) var(--ease-out);
  }
  .card h3 a::after {
    content: '\2192';
    display: inline-block;
    margin-left: 0.3125rem;
    font-size: 0.875em;
    opacity: 0;
    transform: translateX(-5px);
    transition: opacity var(--t-base) var(--ease-out), transform var(--t-base) var(--ease-out);
  }
  .card:hover h3 a { color: var(--accent); }
  .card:hover h3 a::after { opacity: 1; transform: none; }

  .status {
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    flex: none;
  }
  .status[data-s='live'] { color: var(--positive); }
  .card > p { margin-top: var(--space-xs); color: var(--ink-muted); font-size: var(--text-sm); }
  .card > .recognition { margin-top: var(--space-sm); color: var(--accent); font-weight: 600; }
  .tags {
    margin-top: auto;
    padding-top: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }
  .tag {
    font-size: var(--text-2xs);
    color: var(--ink-muted);
    border: 1px solid var(--rule);
    border-radius: 9999px;
    padding: 0.1875rem 0.5rem;
    transition: border-color var(--t-base) var(--ease-out), color var(--t-base) var(--ease-out);
  }
  .tag[data-hit='true'] { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 48rem) {
    .grid { grid-template-columns: 1fr; }
    .card:first-child { display: flex; min-height: 0; }
    .card:first-child .card-media { width: calc(100% + 3.5rem); height: auto; margin: calc(-1 * var(--space-lg)) -1.75rem var(--space-lg); aspect-ratio: 16 / 9; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card-media img { transition: none; }
  }

  /* ---------- method ---------- */
  .method {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border-block: 1px solid var(--rule);
    grid-template-columns: minmax(0, 1fr);
    isolation: isolate;
  }
  @media (min-width: 52rem) { .method { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .mth { position: relative; background: var(--paper); padding: 2.25rem 1.75rem var(--space-lg); }
  .mth::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transition: opacity var(--t-slow) var(--ease-out);
    background: radial-gradient(15rem 15rem at var(--mx) var(--my),
                rgb(0 102 204 / 0.06), transparent 68%);
  }
  .method:hover .mth::before { opacity: 1; }
  .mth > * { position: relative; z-index: 1; }
  .mth { display: flex; flex-direction: column; }
  .mth h3 { font-size: var(--text-lg); }
  .mth .from { margin-top: auto; padding-top: var(--space-md); font-size: var(--text-sm); }
  .mth p { margin-top: var(--space-xs); color: var(--ink-muted); font-size: var(--text-sm); }

  /* ---------- writing ---------- */
  .post {
    display: block;
    text-decoration: none;
    border-block: 1px solid var(--rule);
    padding-block: var(--space-2xl);
    transition: padding-left var(--t-slow) var(--ease-out);
  }
  .post:hover { padding-left: var(--space-xs); }
  .post .when { font-size: var(--text-sm); color: var(--ink-faint); }
  .post h3 { margin-top: var(--space-2xs); font-size: var(--text-2xl); letter-spacing: var(--tracking-head); }
  .post > p { margin-top: var(--space-xs); color: var(--ink-muted); max-width: var(--measure-wide); }
  .post .go { margin-top: var(--space-sm); }

  /* ---------- closing ---------- */
  .figs {
    display: grid;
    gap: var(--space-2xl);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin-bottom: var(--space-3xl);
  }
  .fig { border-top: 1px solid var(--rule-dark); padding-top: var(--space-sm); }
  .fig b {
    display: block;
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: var(--tracking-head);
  }
  .hail h2 { max-width: 18ch; }
  .hail .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    margin-top: var(--space-lg);
  }
  .hail .links a {
    font-size: var(--text-md);
    color: var(--accent-lift);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color var(--t-base) var(--ease-out);
  }
  .hail .links a:hover { border-bottom-color: currentColor; }
</style>
