---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const STATUS_TEXT: Record<string, string> = {
  live: 'Running',
  shipped: 'Shipped',
  building: 'In progress',
  archived: 'Archived',
};
---
<Base title={d.title} description={d.summary}>
  <article class="wrap">
    <header>
      <p class="label"><a href="/work">Work</a> <span aria-hidden="true">/</span> {d.title}</p>
      <h1>{d.headline}</h1>
      <p class="lede">{d.summary}</p>
      <dl class="facts">
        <div>
          <dt>Status</dt>
          <dd>
            {d.status === 'live' && <span class="dot" aria-hidden="true"></span>}
            {STATUS_TEXT[d.status]}
          </dd>
        </div>
        <div>
          <dt>Year</dt>
          <dd>{d.period}</dd>
        </div>
        <div>
          <dt>Built with</dt>
          <dd>{d.stack.join(', ')}</dd>
        </div>
        {((d.repo && d.sourceReviewed) || d.demo) && (
          <div>
            <dt>Links</dt>
            <dd class="links">
              {d.repo && d.sourceReviewed && <a class="link" href={d.repo} rel="noopener">Source</a>}
              {d.demo && <a class="link" href={d.demo} rel="noopener">Live</a>}
            </dd>
          </div>
        )}
      </dl>
      {d.recognition && <p class="recognition">{d.recognition}</p>}
    </header>
    {d.takeaways.length > 0 && (
      <section class="takeaways" aria-labelledby="takeaways-title">
        <h2 id="takeaways-title">What I would reuse</h2>
        <ul>
          {d.takeaways.map((t) => <li>{t}</li>)}
        </ul>
      </section>
    )}
    {d.media.length > 0 && (
      <div class="gallery" aria-label="Project interface screenshots">
        {d.media.map((item, index) => (
          <figure>
            <img src={item.src} alt={item.alt} loading={index === 0 ? 'eager' : 'lazy'} />
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    <nav class="tail">
      <a class="link" href="/work">&larr; All projects</a>
    </nav>
  </article>
</Base>

<style>
  article { padding-block: var(--space-2xl) var(--space-xl); }

  header { margin-bottom: var(--space-xl); }
  header .label { margin-bottom: var(--space-sm); }
  header .label a { color: inherit; text-decoration: none; }
  header .label a:hover { color: var(--accent); }

  h1 {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-snug);
  }

  .lede {
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--ink-muted);
    max-width: var(--measure);
    margin-top: var(--space-sm);
  }

  .recognition { margin-top: var(--space-md); color: var(--accent); font-weight: 600; font-size: var(--text-sm); }

  .takeaways {
    max-width: var(--measure);
    margin-bottom: var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-sunk);
  }
  .takeaways h2 {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
  }
  .takeaways ul { list-style: none; padding: 0; margin-top: var(--space-sm); display: grid; gap: var(--space-sm); }
  .takeaways li {
    position: relative;
    padding-left: var(--space-md);
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }
  .takeaways li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 0.125rem;
    border-radius: 1px;
    background: var(--accent);
  }
  @media (max-width: 34rem) {
    .takeaways { padding: var(--space-md); }
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-xl);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--rule);
  }
  .facts dt {
    font-variant-numeric: tabular-nums;
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.3rem;
  }
  .facts dd { margin: 0; font-size: var(--text-sm); color: var(--ink-muted); }
  .facts .links { display: flex; gap: var(--space-sm); }

  .dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
    margin-right: 0.4rem;
    vertical-align: baseline;
  }

  .gallery { display: grid; gap: var(--space-lg); margin-bottom: var(--space-xl); }
  .gallery figure { margin: 0; }
  .gallery img { display: block; width: 100%; height: auto; border: var(--hairline) solid var(--rule); border-radius: var(--radius-md); box-shadow: var(--shadow-product); }
  .gallery figcaption { margin-top: var(--space-2xs); color: var(--ink-faint); font-size: var(--text-sm); }

  .tail {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--rule);
    font-size: var(--text-sm);
  }
</style>
